# Static SPA server with client-side routing fallback.
# Railway injects $PORT; Caddy listens on it and serves index.html for any
# unknown path so React Router routes (/login, /customers, ...) resolve.
:{$PORT:80} {
	root * /usr/share/caddy
	encode gzip zstd

	# Vite emits content-hashed filenames under /assets, so they are safe to
	# cache forever — a new build produces new names.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Everything else (notably index.html) must be revalidated every time, so a
	# new deploy is picked up immediately instead of a stale cached shell.
	@nohash not path /assets/*
	header @nohash Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}
