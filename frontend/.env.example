# Base URL of the Laravel API (no trailing slash), including the /api prefix.
#
# Local dev:
#   VITE_API_URL=http://127.0.0.1:8000/api
#
# Railway (two-service deploy): set this in the React service's Variables to the
# deployed Laravel API domain, e.g.
#   VITE_API_URL=https://laravel-api-production.up.railway.app/api
#
# NOTE: Vite bakes this into the bundle at BUILD time — after changing it on
# Railway you must redeploy the frontend for the new value to take effect.
VITE_API_URL=http://127.0.0.1:8000/api
